#!/usr/bin/env python3
"""bin/research-lint — check research output before SHIP. Non-optional, same-turn.

Extracts dates, URLs, and source sections from a markdown file and flags:
  1. Sources outside a freshness window (default 180 days = ~6 months)
  2. Missing Sources/References section
  3. No URLs cited
  4. Gap enumeration prompt (what did you search for? what didn't you?)

Usage:
  bin/research-lint <file.md> [--window-days N]

Exit 0 = clean, exit 1 = warnings found, exit 2 = usage/error.
Part of the VERIFY step. Runs before SHIP, every time.
"""
import sys
import re
import os
from datetime import datetime, timezone, timedelta

def parse_args(argv):
    file = None
    window_days = 180
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print("Usage: bin/research-lint <file.md> [--window-days N]")
            print("Default window: 180 days (~6 months)")
            sys.exit(0)
        elif arg == "--window-days":
            if i + 1 >= len(argv):
                print("error: --window-days requires a value", file=sys.stderr)
                sys.exit(2)
            window_days = int(argv[i + 1])
            i += 2
        elif arg.startswith("--window-days="):
            window_days = int(arg.split("=", 1)[1])
            i += 1
        else:
            file = arg
            i += 1
    return file, window_days

def extract_dates(content):
    """Find all dates in the content. Returns list of (line_no, datetime, raw_text)."""
    lines = content.split("\n")
    patterns = [
        (r'\b(20\d{2})-(\d{2})-(\d{2})\b', 'iso'),
        (r'\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\w*\s+(\d{1,2}),?\s+(20\d{2})\b', 'long'),
        (r'\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\w*\s+(20\d{2})\b', 'month_year'),
    ]
    month_map = {
        'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,
        'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12,
    }
    results = []
    for i, line in enumerate(lines, 1):
        for pat, fmt in patterns:
            for m in re.finditer(pat, line, re.IGNORECASE):
                try:
                    if fmt == 'iso':
                        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
                        dt = datetime(y, mo, d, tzinfo=timezone.utc)
                    elif fmt == 'long':
                        mo = month_map[m.group(1)[:3].lower()]
                        d = int(m.group(2))
                        y = int(m.group(3))
                        dt = datetime(y, mo, d, tzinfo=timezone.utc)
                    elif fmt == 'month_year':
                        mo = month_map[m.group(1)[:3].lower()]
                        y = int(m.group(2))
                        dt = datetime(y, mo, 1, tzinfo=timezone.utc)
                    else:
                        continue
                    results.append((i, dt, m.group(0)))
                except (ValueError, KeyError):
                    continue
    return results

def main():
    file_path, window_days = parse_args(sys.argv[1:])

    if file_path is None:
        print("error: no file specified", file=sys.stderr)
        print("Usage: bin/research-lint <file.md> [--window-days N]", file=sys.stderr)
        sys.exit(2)

    if not os.path.isfile(file_path):
        print(f"error: file not found: {file_path}", file=sys.stderr)
        sys.exit(2)

    with open(file_path, 'r') as f:
        content = f.read()

    warnings = 0
    now = datetime.now(timezone.utc)
    cutoff = now - timedelta(days=window_days)

    print(f"=== research-lint: {file_path} ===")
    print(f"freshness window: {window_days} days (cutoff: {cutoff.strftime('%Y-%m-%d')})")
    print()

    # --- Check 1: dates ---
    all_dates = extract_dates(content)
    stale = [(ln, dt, raw) for ln, dt, raw in all_dates if dt < cutoff]

    if stale:
        print(f"STALE: {len(stale)} of {len(all_dates)} date(s) outside freshness window:")
        for ln, dt, raw in stale:
            print(f"  line {ln}: {raw} ({dt.strftime('%Y-%m-%d')})")
        warnings += 1
    else:
        print(f"OK: all {len(all_dates)} date(s) within freshness window")
    print()

    # --- Check 2: Sources section ---
    print("--- Sources section ---")
    if re.search(r'^#+\s*(sources|references|citations)', content, re.IGNORECASE | re.MULTILINE):
        print("INFO: Sources section found")
    else:
        print("WARN: No 'Sources' or 'References' section found")
        warnings += 1
    print()

    # --- Check 3: URL inventory ---
    print("--- URL inventory ---")
    urls = set(re.findall(r'https?://[^\s)>]+', content))
    print(f"INFO: {len(urls)} unique URL(s) found")
    if not urls:
        print("WARN: No URLs cited in the document")
        warnings += 1
    print()

    # --- Check 4: gap enumeration prompt ---
    print("--- Gap enumeration (manual) ---")
    print("Search queries used (enumerate what you searched FOR):")
    print("  [Fill in: what terms did you search?]")
    print()
    print("Search queries NOT used (what you didn't search for):")
    print("  [Fill in: what adjacent terms might surface different results?]")
    print()

    # --- Summary ---
    print("=== summary ===")
    if warnings == 0:
        print("CLEAN: no automated warnings. Complete the gap enumeration manually.")
        sys.exit(0)
    else:
        print(f"{warnings} warning(s) found. Fix before SHIP.")
        sys.exit(1)

if __name__ == "__main__":
    main()
