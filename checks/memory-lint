#!/usr/bin/env python3
"""bin/memory-lint — programmatic corpus health checks.

The manual lint pass (schedule 1fee2fa2, daily 4:45 PM) catches things by eye;
this is the structural version — a CHECK constraint, not a convention.

Implements issue #24: bin/memory-lint.

Checks:
  1. Page size vs caps — two-tier: concept pages (injection pool) > 5K chars,
     reference pages (recall-only) > 25K chars. Flags page name and current size.
  2. Orphaned references — [[wikilinks]] in concept pages pointing to
     pages whose slug doesn't exist in the corpus.
  3. NOW.md freshness — file mtime > 24h (warn) or > 48h (flag).
  4. Buffer age — entries in memory/buffer.md with timestamps older than
     the stated consolidation cutoff (should have been processed already).
  5. Critical files tracked in git — journal.md/buffer.md/NOW.md/SOUL.md
     must have version history (the Aug 31 safety-net race class).
  6. Stamp consistency — paired local/UTC stamps in NOW.md, recent.md, and
     buffer.md must agree in the America/Denver zone (the Sep 1/5/6
     hand-conversion error class; third strike → structural check). Since
     Sep 8 also scans LOCAL-ONLY stamps (no UTC pair — the shape every
     writer actually uses) on NOW.md/recent.md line 1, buffer.md entries,
     and archive day files modified within 48h: a stamp in the future, or
     later than its file's last write, fails loud (the UTC-read-as-local
     class; Sep 8: 100+ stamps sat ~6h wrong with the pair check silent).
  7. Link graveyard — links in hot concept pages pointing at targets that
     no longer exist (moved to archive, renamed, deleted), plus frontmatter
     links to reference-tier targets (unreachable per the settled resolver
     rule, Sep 9 — route those via body prose). Detection only.

Usage:
  python3 bin/memory-lint [--workspace PATH] [--stamps]

  --stamps runs only check 6 — cheap enough for heartbeat cadence (the
  stamp-later-than-mtime rule only catches the UTC-as-local class while
  fresh; daily-only runs miss stamps older than ~6h).

Exit 0 = clean, exit 1 = issues found, exit 2 = usage/error.
"""
import sys
import subprocess
import re
import os
import glob
from datetime import datetime, timezone, timedelta

# --- Config -------------------------------------------------------------

CONCEPT_CAP = 5000      # chars — hot concept pages (in injection pool)
REFERENCE_CAP = 25000   # chars — reference pages (recall-only, zero per-conversation cost)
NOW_WARN_HOURS = 24     # NOW.md mtime older than this → warn
NOW_FLAG_HOURS = 48     # NOW.md mtime older than this → flag

MONTHS = {
    'jan': 1, 'feb': 2, 'mar': 3, 'apr': 4, 'may': 5, 'jun': 6,
    'jul': 7, 'aug': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dec': 12,
}

# --- Helpers ------------------------------------------------------------

def find_workspace():
    """Locate the workspace root (parent of bin/)."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    return os.path.dirname(script_dir)

def parse_frontmatter_slug(content):
    """Extract slug from YAML frontmatter. Returns slug or None."""
    m = re.search(r'^slug:\s*(.+)$', content, re.MULTILINE)
    if m:
        return m.group(1).strip()
    return None

def extract_wikilinks(content):
    """Find all [[slug]] wikilinks in content. Returns list of slugs."""
    return re.findall(r'\[\[([^\]]+)\]\]', content)

def iter_frontmatter_link_entries(content):
    """Yield (lineno, target) for each entry of the frontmatter `links:` list.

    Entry shapes in the wild (the-fleet.md, arcs pages): `- "target -
    description"` or `- "target — description"`; the target is the text
    before the first ' - ' / ' — ' separator. Entries without a separator
    are bare targets. Blank lines inside the list are tolerated.
    """
    lines = content.split('\n')
    if not lines or lines[0].strip() != '---':
        return []
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == '---':
            end = i
            break
    if end is None:
        return []
    out = []
    in_links = False
    for i in range(1, end):
        ln = lines[i]
        if re.match(r'^links:\s*$', ln):
            in_links = True
            continue
        if not in_links:
            continue
        m = re.match(r'^\s*-\s+(.*)$', ln)
        if m:
            entry = m.group(1).strip()
            if len(entry) >= 2 and entry[0] in ('"', "'") and entry[-1] == entry[0]:
                entry = entry[1:-1]
            target = re.split(r'\s+[-—]\s+', entry, maxsplit=1)[0].strip()
            if target:
                out.append((i + 1, target))
        elif ln.strip() == '':
            continue  # blank line inside the list (the-fleet.md shape)
        else:
            in_links = False  # next frontmatter key — list over
    return out

def parse_informal_date(text):
    """Parse informal dates like 'Sep 2, 2:10 PM' or 'Sep 2, 1:37 PM'.

    Assumes current year (no year in the format). Returns datetime or None.
    """
    # Match: Mon DD, H:MM AM/PM
    m = re.match(
        r'(\w{3})\w*\s+(\d{1,2}),\s+(\d{1,2}):(\d{2})\s*(AM|PM)',
        text.strip(), re.IGNORECASE
    )
    if not m:
        return None
    mon_name = m.group(1)[:3].lower()
    if mon_name not in MONTHS:
        return None
    month = MONTHS[mon_name]
    day = int(m.group(2))
    hour = int(m.group(3))
    minute = int(m.group(4))
    ampm = m.group(5).upper()
    if ampm == 'PM' and hour != 12:
        hour += 12
    elif ampm == 'AM' and hour == 12:
        hour = 0
    year = datetime.now(timezone.utc).year
    try:
        return datetime(year, month, day, hour, minute, tzinfo=timezone.utc)
    except ValueError:
        return None

# --- Checks --------------------------------------------------------------

def check_page_sizes(ws):
    """Check 1: concept pages and reference pages against size caps.

    Two-tier caps because the two directories have different cost models:
    - memory/concepts/** is in the v3 injection pool (costs tokens every turn)
    - memory/reference/** is recall-only (zero per-conversation cost)
    Applying a single cap to both measures the wrong dimension.
    """
    issues = []
    warnings = []

    concept_files = sorted(glob.glob(os.path.join(ws, 'memory/concepts/**/*.md'), recursive=True))
    for f in concept_files:
        size = os.path.getsize(f)
        if size > CONCEPT_CAP:
            rel = os.path.relpath(f, ws)
            issues.append(f"  OVER CAP ({size} > {CONCEPT_CAP}): {rel}")

    reference_files = sorted(glob.glob(os.path.join(ws, 'memory/reference/**/*.md'), recursive=True))
    for f in reference_files:
        size = os.path.getsize(f)
        if size > REFERENCE_CAP:
            rel = os.path.relpath(f, ws)
            issues.append(f"  OVER CAP ({size} > {REFERENCE_CAP}): {rel}")

    return issues, warnings

def check_orphaned_references(ws):
    """Check 2: wikilinks in concept pages pointing to non-existent slugs."""
    issues = []
    warnings = []

    # Build slug set from all concept pages (frontmatter slug field)
    valid_slugs = set()
    concept_files = sorted(glob.glob(os.path.join(ws, 'memory/concepts/**/*.md'), recursive=True))
    for f in concept_files:
        with open(f, 'r') as fh:
            content = fh.read()
        slug = parse_frontmatter_slug(content)
        if slug:
            valid_slugs.add(slug)
        # Also register the filename stem as a valid slug (belt + suspenders)
        valid_slugs.add(os.path.splitext(os.path.basename(f))[0])

    # Scan all concept pages for wikilinks
    for f in concept_files:
        with open(f, 'r') as fh:
            content = fh.read()
        rel = os.path.relpath(f, ws)
        for slug in extract_wikilinks(content):
            # Strip any display text after | (e.g. [[slug|display]])
            target = slug.split('|')[0].strip()
            if target not in valid_slugs:
                issues.append(f"  ORPHANED [[{target}]] in {rel} — no page with slug '{target}'")

    return issues, warnings

def check_now_freshness(ws):
    """Check 3: NOW.md mtime against freshness thresholds."""
    issues = []
    warnings = []

    now_path = os.path.join(ws, 'NOW.md')
    if not os.path.exists(now_path):
        issues.append("  MISSING: NOW.md not found")
        return issues, warnings

    mtime = datetime.fromtimestamp(os.path.getmtime(now_path), tz=timezone.utc)
    now = datetime.now(timezone.utc)
    age_hours = (now - mtime).total_seconds() / 3600

    if age_hours > NOW_FLAG_HOURS:
        issues.append(f"  STALE ({age_hours:.1f}h > {NOW_FLAG_HOURS}h): NOW.md last modified {mtime.strftime('%Y-%m-%d %H:%M UTC')}")
    elif age_hours > NOW_WARN_HOURS:
        warnings.append(f"  AGING ({age_hours:.1f}h > {NOW_WARN_HOURS}h): NOW.md last modified {mtime.strftime('%Y-%m-%d %H:%M UTC')}")

    return issues, warnings

def check_buffer_age(ws):
    """Check 4: buffer.md entries older than the consolidation cutoff."""
    issues = []
    warnings = []

    buf_path = os.path.join(ws, 'memory/buffer.md')
    if not os.path.exists(buf_path):
        warnings.append("  NOTE: memory/buffer.md not found — skipping buffer age check")
        return issues, warnings

    with open(buf_path, 'r') as fh:
        content = fh.read()

    # Parse cutoff
    cutoff = None
    cm = re.search(r'Cutoff:\s*(.+?)\.?\s*$', content, re.MULTILINE)
    if cm:
        cutoff = parse_informal_date(cm.group(1))
    if cutoff is None:
        warnings.append("  NOTE: could not parse consolidation cutoff from buffer.md — skipping age check")
        return issues, warnings

    # Parse entries: lines starting with "- [Mon DD, H:MM AM/PM]"
    for m in re.finditer(r'^-\s*\[([^\]]+)\]', content, re.MULTILINE):
        entry_ts = parse_informal_date(m.group(1))
        if entry_ts and entry_ts < cutoff:
            issues.append(f"  STALE ENTRY ({m.group(1)} < cutoff {cm.group(1)}): should have been consolidated")

    return issues, warnings

# --- Main ----------------------------------------------------------------

def check_tracked_critical_files(ws):
    """Check 5: critical content files must be tracked in git.

    Found Sep 5: the safety net raced the consolidation's atomic rewrite of
    journal.md on Aug 31 (commit cac5d588 committed the deletion mid-rewrite)
    and every journal entry since then had no commit evidence. The net is
    platform-side and can't be fixed from here; this check catches the
    recurrence the net can't prevent.
    """
    issues = []
    warnings = []

    critical = [
        "memory/journal/journal.md",
        "memory/buffer.md",
        "NOW.md",
        "SOUL.md",
    ]
    for rel in critical:
        path = os.path.join(ws, rel)
        if not os.path.exists(path):
            warnings.append(f"  MISSING ON DISK: {rel}")
            continue
        r = subprocess.run(
            ["git", "-C", ws, "ls-files", "--error-unmatch", "--", rel],
            capture_output=True,
        )
        if r.returncode != 0:
            issues.append(f"  UNTRACKED IN GIT: {rel} (exists on disk, no version history — re-add before the next entry)")

    return issues, warnings

def check_stamp_consistency(ws):
    """Check 6: paired local/UTC stamps must agree in the Denver zone.

    Found 3x (Sep 1, Sep 5, Sep 6): passes hand-compose stamps like
    "9:39 PM MDT (21:39 UTC)" — reading 24h UTC as a PM local time, when
    21:39 UTC is 3:39 PM MDT. The "use bin/now, never hand-convert"
    convention decayed three times; this check is the structural version.
    Surfaces: line 1 of NOW.md, line 1 of memory/recent.md, the Cutoff
    line of memory/buffer.md. Phase 1 skips local-only stamps (no UTC
    pair) — nothing to cross-check. Phase 2 (Sep 8) scans local-only
    stamps on NOW.md/recent.md line 1, every buffer.md line, and archive
    day files modified within 48h: FUTURE (> now+5min) or LATER-THAN-
    MTIME (> file mtime +10min) fail loud. The UTC-read-as-local class
    always claims +6h, so the mtime rule catches it from the bad write
    until the file's mtime passes the claim — run frequently (heartbeat
    --stamps) to catch it fresh; older ones need git anchoring.
    """
    issues = []
    warnings = []

    try:
        from zoneinfo import ZoneInfo
        denver = ZoneInfo("America/Denver")
    except Exception:
        return issues, ["  NOTE: zoneinfo unavailable — stamp consistency check skipped"]

    pair_re = re.compile(
        r'(\w{3})\w*\s+(\d{1,2}),\s*~?\s*(\d{1,2}):(\d{2})\s*(AM|PM)\s*(?:MDT|MST)'
        r'\s*\(\s*~?\s*(\d{1,2}):(\d{2})\s*(AM|PM)?\s*UTC\s*\)',
        re.IGNORECASE,
    )

    surfaces = [
        ("NOW.md", os.path.join(ws, "NOW.md"), 1),
        ("memory/recent.md", os.path.join(ws, "memory", "recent.md"), 1),
        ("memory/buffer.md", os.path.join(ws, "memory", "buffer.md"), None),
    ]
    now = datetime.now(timezone.utc)
    year = now.year

    for rel, path, lineno in surfaces:
        if not os.path.exists(path):
            warnings.append(f"  NOTE: {rel} not found — stamp check skipped for this surface")
            continue
        with open(path, 'r') as fh:
            lines = fh.readlines()
        text = None
        if lineno is not None:
            text = lines[lineno - 1] if len(lines) >= lineno else None
        else:
            for ln in lines:
                if ln.startswith("Cutoff:"):
                    text = ln
                    break
        if text is None:
            continue
        m = pair_re.search(text)
        if not m:
            continue  # local-only stamp — nothing to cross-check
        mon, day, lh, lmin, lampm, uh, umin, uampm = m.groups()
        month = MONTHS.get(mon[:3].lower())
        if not month:
            continue
        lh, lmin, uh, umin, day = int(lh), int(lmin), int(uh), int(umin), int(day)
        if lampm.upper() == 'PM' and lh != 12:
            lh += 12
        elif lampm.upper() == 'AM' and lh == 12:
            lh = 0
        if uampm:
            uh24 = uh
            if uampm.upper() == 'PM' and uh != 12:
                uh24 += 12
            elif uampm.upper() == 'AM' and uh == 12:
                uh24 = 0
        else:
            uh24 = uh
        try:
            stated_local = datetime(year, month, day, lh, lmin, tzinfo=denver)
        except ValueError:
            continue
        # Compare by converting the stated local time to UTC — robust across
        # UTC-midnight crossings (e.g. "6:50 PM MDT (00:50 UTC)" is valid:
        # the UTC side belongs to the next UTC day, which carries no date).
        stated_utc = stated_local.astimezone(timezone.utc)
        if (stated_utc.hour, stated_utc.minute) != (uh24, umin):
            issues.append(
                f"  STAMP MISMATCH ({rel}): \"{text.strip()}\" — stated local time is "
                f"{stated_utc:%H:%M} UTC, but the stamp says {uh24:02d}:{umin:02d} UTC. "
                f"Fix from bin/now or git commit times; never hand-convert."
            )
            continue
        if stated_utc - now > timedelta(minutes=5):
            issues.append(
                f"  STAMP IN FUTURE ({rel}): \"{text.strip()}\" — stamps record past moments; "
                f"this one is ahead of now"
            )

    # --- Phase 2: local-only stamps (added Sep 8, 2026) ---
    # Phase 1 only judges stamps carrying a "(HH:MM UTC)" pair. Every real
    # writer (heartbeats, consolidation/retrospective passes, conversation
    # close-outs) stamps local-only: "[Sep 8, 10:41 PM]". On Sep 8 an entire
    # day of archive/buffer/recent stamps sat ~6h wrong (raw UTC clock read
    # as local) and phase 1 saw none of them — local-only was skipped by
    # design. Two mechanical rules, no zone inference:
    #   (a) FUTURE: a stamp later than now+5min is wrong at any check time.
    #   (b) MTIME: a stamp later than its file's last write +10min claims an
    #       impossible write moment. The UTC-read-as-local class always
    #       claims +6h, so this catches it from the bad write until the
    #       file's mtime passes the claim — run frequently to catch fresh.
    # Honest limit: a wrong stamp whose claimed time has passed AND been
    # overtaken by later writes is no longer mechanically distinguishable;
    # fix those by git anchoring (first commit containing the line).
    local_re = re.compile(
        r'(\w{3})\w*\s+(\d{1,2}),\s*~?\s*(\d{1,2}):(\d{2})\s*(AM|PM)\b',
        re.IGNORECASE,
    )

    def _mtime_utc(path):
        try:
            return datetime.fromtimestamp(os.path.getmtime(path), tz=timezone.utc)
        except OSError:
            return None

    local_surfaces = [
        ("NOW.md", os.path.join(ws, "NOW.md"), True),
        ("memory/recent.md", os.path.join(ws, "memory", "recent.md"), True),
        ("memory/buffer.md", os.path.join(ws, "memory", "buffer.md"), False),
    ]
    for apath in sorted(glob.glob(os.path.join(ws, "memory", "archive", "*.md"))):
        amtime = _mtime_utc(apath)
        if amtime and now - amtime <= timedelta(hours=48):
            local_surfaces.append(
                (f"memory/archive/{os.path.basename(apath)}", apath, False)
            )

    for rel, path, first_line_only in local_surfaces:
        if not os.path.exists(path):
            continue
        mt = _mtime_utc(path)
        with open(path, 'r') as fh:
            lines = fh.readlines()
        if first_line_only:
            lines = lines[:1]
        seen = set()
        for ln, text in enumerate(lines, 1):
            pair_spans = [(m.start(), m.end()) for m in pair_re.finditer(text)]
            for m in local_re.finditer(text):
                if any(s <= m.start() < e for s, e in pair_spans):
                    continue  # local half of a pair — phase 1 judged it
                if (ln, m.group(0)) in seen:
                    continue  # same stamp quoted twice on one line
                seen.add((ln, m.group(0)))
                month = MONTHS.get(m.group(1)[:3].lower())
                if not month:
                    continue
                day, lh, lmin = int(m.group(2)), int(m.group(3)), int(m.group(4))
                ampm = m.group(5).upper()
                if ampm == 'PM' and lh != 12:
                    lh += 12
                elif ampm == 'AM' and lh == 12:
                    lh = 0
                stamp_local = None
                for yr in (year, year - 1):  # Dec/Jan boundary tolerance
                    try:
                        cand = datetime(yr, month, day, lh, lmin, tzinfo=denver)
                    except ValueError:
                        continue
                    if cand.astimezone(timezone.utc) - now <= timedelta(days=45):
                        stamp_local = cand
                        break
                if stamp_local is None:
                    continue
                stamp_utc = stamp_local.astimezone(timezone.utc)
                frag = m.group(0)
                if stamp_utc - now > timedelta(minutes=5):
                    issues.append(
                        f"  LOCAL-ONLY STAMP IN FUTURE ({rel}, line {ln}): \"{frag}\" — "
                        f"stamps record past moments; raw-clock UTC read as local. "
                        f"Fix from bin/now or git anchors; never hand-convert."
                    )
                elif mt is not None and stamp_utc - mt > timedelta(minutes=10):
                    issues.append(
                        f"  STAMP LATER THAN LAST WRITE ({rel}, line {ln}): \"{frag}\" — "
                        f"claims a write moment after the file's last write "
                        f"(UTC-read-as-local class). Anchor from git "
                        f"(first commit containing the line) and correct."
                    )

    return issues, warnings

def check_link_graveyard(ws):
    """Check 7: link graveyard — links in hot concept pages whose targets no
    longer exist (moved to archive, renamed, or deleted), plus frontmatter
    links to reference-tier targets (unreachable per the settled resolver
    rule, Sep 9). Issue #34; detection only, no auto-fix.

    Sources: memory/concepts/** only. Reference-tier pages as link SOURCES
    are known residual debt (gotchas resolver entry) — not this slice.

    Resolution model (settled Sep 9, after three falsifications):
      - frontmatter `links:` entries and body [[wikilinks]] resolve ONLY
        against memory/concepts/ (bare slug, arcs/<slug>, or any concepts
        subpath). A target whose page exists elsewhere is flagged
        UNREACHABLE FORM — route via body prose; if the page now lives in
        memory/archive/ and the link doesn't already point there, it's
        flagged ROTTED instead (the link predates an archiving move).
      - body prose paths (reference/..., archive/..., concepts/... — the
        settled routing form for anything outside concepts/) resolve
        against the filesystem: memory/<path>.md, the directory itself, or
        its INDEX.md. Resolving targets are VALID — explicit archive paths
        are redirects, not dead links (issue #34 done-when). A target that
        doesn't resolve is flagged DEAD PATH.

    Not scanned: `main:` frontmatter fields (the resolver model covers
    `links:` only) and bare backticked slugs (→ `slug` arrow notation,
    outside issue #34's scope). Overlap: a ROTTED wikilink also fires
    check 2's ORPHANED — both true, different detail (check 2 says the
    slug isn't in concepts/; this check says where it went).
    """
    issues = []
    warnings = []

    concept_files = sorted(glob.glob(os.path.join(ws, 'memory/concepts/**/*.md'), recursive=True))
    if not concept_files:
        warnings.append("  NOTE: no concept pages found — link graveyard check skipped")
        return issues, warnings

    # concepts resolution set: relpaths (no .md) + frontmatter slugs
    concepts_targets = set()
    for f in concept_files:
        rel = os.path.relpath(f, ws)
        base = rel[len('memory/concepts/'):]
        if base.endswith('.md'):
            base = base[:-len('.md')]
        concepts_targets.add(base)
        with open(f, 'r') as fh:
            slug = parse_frontmatter_slug(fh.read())
        if slug:
            concepts_targets.add(slug)

    # tier indexes: filename stem -> relpath (memory/-prefixed), for bare-slug
    # links aimed at pages that live outside concepts/ (e.g. "littlebird" ->
    # memory/reference/people/littlebird.md, or an archived slug)
    ref_hits = {}
    for f in glob.glob(os.path.join(ws, 'memory/reference/**/*.md'), recursive=True):
        stem = os.path.splitext(os.path.basename(f))[0]
        ref_hits.setdefault(stem, os.path.relpath(f, ws))
    archive_hits = {}
    for f in glob.glob(os.path.join(ws, 'memory/archive/**/*.md'), recursive=True):
        stem = os.path.splitext(os.path.basename(f))[0]
        archive_hits.setdefault(stem, os.path.relpath(f, ws))

    def locate_page(target):
        """Where does the target page actually live? Returns a memory/-prefixed
        relpath, or None if no page matches in any tier. Exact forms first
        (full path, INDEX form), then stem search across reference/ and
        archive/ (reference wins — a live page beats an archived one)."""
        for cand in (target + '.md', 'reference/' + target + '.md',
                     os.path.join(target, 'INDEX.md'),
                     os.path.join('reference', target, 'INDEX.md')):
            if os.path.exists(os.path.join(ws, 'memory', cand)):
                return 'memory/' + cand
        for idx in (ref_hits, archive_hits):
            hit = idx.get(target) or idx.get(target.split('/')[-1])
            if hit:
                return hit
        return None

    def classify_slug_target(target, rel, lineno, form):
        """form: 'frontmatter link' or 'wikilink' — resolves against concepts/ only."""
        if target in concepts_targets:
            return
        loc = locate_page(target)
        if loc is None:
            issues.append(
                f"  DEAD LINK ({rel}, line {lineno}): \"{target}\" — no page with this slug in concepts/, reference/, or archive/"
            )
            return
        if loc.startswith('memory/archive/') and not target.startswith('archive/'):
            issues.append(
                f"  ROTTED LINK ({rel}, line {lineno}): \"{target}\" — target moved to {loc}; "
                f"{form} targets resolve only against memory/concepts/, so the link is dead"
            )
            return
        issues.append(
            f"  UNREACHABLE FORM ({rel}, line {lineno}): \"{target}\" — {form} targets resolve only "
            f"against memory/concepts/ (settled Sep 9); the page exists at {loc} — route via body prose"
        )

    path_re = re.compile(r'(?:memory/)?\b((?:reference|archive|concepts)/[A-Za-z0-9][A-Za-z0-9/_.-]*)')

    for f in concept_files:
        with open(f, 'r') as fh:
            content = fh.read()
        rel = os.path.relpath(f, ws)
        lines = content.split('\n')

        for lineno, target in iter_frontmatter_link_entries(content):
            classify_slug_target(target, rel, lineno, 'frontmatter link')

        for lineno, line in enumerate(lines, 1):
            for m in re.finditer(r'\[\[([^\]]+)\]\]', line):
                classify_slug_target(m.group(1).split('|')[0].strip(), rel, lineno, 'wikilink')
            for m in path_re.finditer(line):
                path = m.group(1).rstrip('.,;:)"\'')
                if not path or path.endswith('-') or path.endswith('/'):
                    continue  # truncated glob / bare dir mention — ambiguous, skip
                stem = path[:-3] if path.endswith('.md') else path
                if any(os.path.exists(p) for p in (
                    os.path.join(ws, 'memory', stem + '.md'),
                    os.path.join(ws, 'memory', stem),
                    os.path.join(ws, 'memory', stem, 'INDEX.md'),
                )):
                    continue
                issues.append(
                    f"  DEAD PATH ({rel}, line {lineno}): \"{m.group(1)}\" — no file at memory/{stem}.md "
                    f"(moved, renamed, or deleted?)"
                )

    return issues, warnings

def check_rm_guard(ws):
    """Check 8: the rm-guard shim must be alive and identical to the canonical copy.

    Shane's standing rule (Sep 11, 2026): no `rm -rf` anywhere — his Mac or
    this workspace. The shim at /usr/local/bin/rm refuses recursive+force
    invocations; container rebuilds wipe /usr/local, so this check fails
    loud when the guard is missing or drifted, and the heartbeat re-arms
    it same-run from <ws>/bin/rm-guard/rm.
    """
    issues = []
    warnings = []
    canonical = os.path.join(ws, "bin", "rm-guard", "rm")
    installed = "/usr/local/bin/rm"

    if not os.path.exists(canonical):
        issues.append(f"  RM-GUARD: canonical copy missing at {canonical} — restore from fleet-home repo (bin/rm-guard/rm)")
        return issues, warnings

    if not os.path.exists(installed):
        issues.append(f"  RM-GUARD: shim not installed at {installed} (container rebuilt?) — re-arm: cp {canonical} {installed} && chmod +x {installed}")
        return issues, warnings

    with open(installed) as f:
        if "rm-guard" not in f.read():
            issues.append(f"  RM-GUARD: {installed} is not the guard (plain rm?) — re-arm: cp {canonical} {installed} && chmod +x {installed}")
            return issues, warnings

    if subprocess.run(["cmp", "-s", canonical, installed]).returncode != 0:
        issues.append(f"  RM-GUARD: installed shim drifted from canonical {canonical} — re-sync: cp {canonical} {installed}")

    return issues, warnings

def main(argv):
    ws = find_workspace()
    only_stamps = False

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif arg == "--stamps":
            only_stamps = True
            i += 1
        elif arg == "--workspace":
            if i + 1 >= len(argv):
                print("error: --workspace requires a value", file=sys.stderr)
                sys.exit(2)
            ws = argv[i + 1]
            i += 2
        elif arg.startswith("--workspace="):
            ws = arg.split("=", 1)[1]
            i += 1
        else:
            print(f"error: unknown argument '{arg}'", file=sys.stderr)
            sys.exit(2)
        i += 0  # handled in branches

    checks = [
        ("1. Page size vs caps", check_page_sizes),
        ("2. Orphaned references", check_orphaned_references),
        ("3. NOW.md freshness", check_now_freshness),
        ("4. Buffer age", check_buffer_age),
        ("5. Critical files tracked in git", check_tracked_critical_files),
        ("6. Stamp consistency (dual-zone)", check_stamp_consistency),
        ("7. Link graveyard (concept-page links)", check_link_graveyard),
        ("8. rm-guard alive (no -rf rule)", check_rm_guard),
    ]
    if only_stamps:
        checks = [c for c in checks if c[0].startswith("6.")]

    total_issues = 0
    total_warnings = 0

    print(f"bin/memory-lint — corpus health check")
    print(f"workspace: {ws}")
    print()

    for label, fn in checks:
        issues, warnings = fn(ws)
        status = "CLEAN" if not issues and not warnings else ("ISSUES" if issues else "WARN")
        marker = "✗" if issues else ("~" if warnings else "✓")
        print(f"  {marker} {label}: {status}")
        for line in issues:
            print(line)
        for line in warnings:
            print(line)
        total_issues += len(issues)
        total_warnings += len(warnings)

    print()
    print(f"  Total: {total_issues} issue(s), {total_warnings} warning(s)")

    if total_issues > 0:
        sys.exit(1)
    sys.exit(0)

if __name__ == "__main__":
    main(sys.argv[1:])
