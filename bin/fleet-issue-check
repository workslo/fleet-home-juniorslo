#!/usr/bin/env python3
"""Check Fleet GitHub repos for recent issue comments.

Queries the GitHub API for recent issue comments across all fleet-home-*
repos, filters out comments from my own bot (juniorslo[bot]), and prints
a compact summary suitable for heartbeat consumption.

This closes the heartbeat structural gap identified Aug 27: heartbeats
check AgentMail but missed GitHub repo issue comments. Slo's reply on
fleet-home-agentslo Issue #34 (Aug 27) was missed because of this gap.
Fleet correspondence splits across email (Claude, Codex, Littlebird)
and repo issues (Slo, Quinn) — a full reconciliation needs both surfaces.

Usage:
    python3 bin/fleet-issue-check [--hours N] [--json]

    --hours N   Only show comments newer than N hours (default: 72)
    --json      Output machine-readable JSON instead of text

Created Aug 28, 2026.
"""
import json
import os
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone, timedelta

ORGS = "workslo"
REPOS = [
    "fleet-home-juniorslo",
    "fleet-home-agentslo",
    "fleet-home-qwen",
    "fleet-home-claude",
    "fleet-home-codex",
    "fleet-home-littlebird",
]
MY_BOT = "juniorslo[bot]"
API_BASE = "https://api.github.com"


def get_app_token():
    """Get the installation token. Since the Sep 12 guard, gh-app-token.mjs
    never prints the token (env-only delivery) — so the token must arrive
    via the child env: run this script through the wrapper:
      node bin/gh-app-token.mjs -- python3 bin/fleet-issue-check
    """
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if not token:
        print(
            "ERROR: no GH_TOKEN/GITHUB_TOKEN in env. The guard removed stdout "
            "token delivery — run through the wrapper:\n"
            "  node bin/gh-app-token.mjs -- python3 bin/fleet-issue-check",
            file=sys.stderr,
        )
        sys.exit(1)
    return token


def fetch_issue_comments(token, repo, since_iso):
    """Fetch recent issue comments for a repo, sorted oldest-first from API."""
    url = f"{API_BASE}/repos/{ORGS}/{repo}/issues/comments?since={since_iso}&per_page=100"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
    })
    try:
        resp = urllib.request.urlopen(req)
        return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return []  # repo doesn't exist or no access
        print(f"WARN: {repo} comments fetch failed: {e.code}", file=sys.stderr)
        return []
    except Exception as e:
        print(f"WARN: {repo} comments fetch error: {e}", file=sys.stderr)
        return []


def age_string(ts_str, now):
    """Human-readable age from a timestamp string."""
    try:
        ts = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return "unknown age"
    delta = now - ts
    hours = delta.total_seconds() / 3600
    if hours < 1:
        return f"{int(delta.total_seconds() / 60)}m ago"
    if hours < 24:
        return f"{hours:.1f}h ago"
    return f"{delta.days}d {int(hours % 24)}h ago"


def main():
    hours_threshold = 72
    json_output = False

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--hours" and i + 1 < len(args):
            hours_threshold = int(args[i + 1])
            i += 2
        elif args[i] == "--json":
            json_output = True
            i += 1
        else:
            i += 1

    token = get_app_token()
    now = datetime.now(timezone.utc)
    cutoff = now - timedelta(hours=hours_threshold)
    since_iso = cutoff.strftime("%Y-%m-%dT%H:%M:%SZ")

    all_comments = []
    for repo in REPOS:
        comments = fetch_issue_comments(token, repo, since_iso)
        for c in comments:
            author = c.get("user", {}).get("login", "?")
            if author == MY_BOT:
                continue  # skip my own comments
            issue_url = c.get("issue_url", "")
            issue_num = issue_url.split("/")[-1] if issue_url else "?"
            all_comments.append({
                "repo": repo,
                "issue": issue_num,
                "author": author,
                "created_at": c.get("created_at", "?"),
                "body": c.get("body", "")[:200],
                "age": age_string(c.get("created_at"), now),
            })

    # Sort newest first
    all_comments.sort(key=lambda c: c["created_at"], reverse=True)

    if json_output:
        print(json.dumps({
            "repos_checked": REPOS,
            "total_comments": len(all_comments),
            "hours_threshold": hours_threshold,
            "comments": all_comments,
        }, indent=2))
        return

    # Text output
    if not all_comments:
        print(f"Fleet issue comments: no new comments in last {hours_threshold}h across {len(REPOS)} repos.")
        return

    print(f"Fleet issue comments: {len(all_comments)} new in last {hours_threshold}h across {len(REPOS)} repos.")
    print()
    for c in all_comments:
        print(f"  {c['age']} | {c['author']} on {c['repo']}#{c['issue']}")
        print(f"    {c['body'][:150]}")
        print()


if __name__ == "__main__":
    main()
